{
  "name": "jamie-node-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "node:add": "python3 deploy/onboard.py",
    "dev": "vite --config vite.portal.config.ts",
    "build": "vite build --config vite.portal.config.ts",
    "check": "tsc --noEmit",
    "check:python": "uvx ruff@0.16.8 check backend deploy/onboard.py deploy/nodes && uvx --from pylint==4.0.8 pylint --disable=all --enable=duplicate-code --min-similarity-lines=6 --ignore-patterns='test_.*' --score=no backend/*.py",
    "test:python": "uv run --with pyyaml --no-project python -m unittest discover -s backend -p 'test*.py'",
    "lint": "oxlint",
    "format": "oxfmt",
    "test:frontend": "node --test portal/navigation.test.mjs portal/features.test.mjs portal/dock.test.mjs",
    "verify": "npm run check:python && npm run test:python && npm run check && npm run test:frontend && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "qrcode": "^1.5.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  },
  "type": "module"
}
